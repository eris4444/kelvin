#!/bin/bash
# Kelvin privileged helper: ASUS custom fan curves.
#
# Runs as root through pkexec (polkit action dev.erisrtg.kelvin.fans). It only
# writes the kernel's asus-wmi "asus_custom_fan_curve" hwmon attributes:
#
#   set  cpu|gpu T1:P1,...,T8:P8   write an 8-point curve and enable it
#   auto cpu|gpu                   back to the firmware curve (factory default
#                                  for the current ASUS thermal profile)
#
# T is °C, P is the PWM duty 0-255. Safety rules enforced here, whatever the
# caller asks for (the EC keeps its own thermal protection on top):
#   * temperatures strictly increase, PWM never decreases (kernel requires it)
#   * at >= 70 °C the fan runs at least 25 % (64), at >= 80 °C at least 50 % (128)
#   * the last point is at most 95 °C and at least 50 % (128)
# If the kernel rejects a curve, the firmware curve is restored.

set -euo pipefail
export PATH=/usr/bin:/bin

die() {
  local code=$1
  shift
  echo "kelvin-fan-helper: $*" >&2
  exit "$code"
}

(($# >= 2)) || die 2 "usage: kelvin-fan-helper set cpu|gpu T:P,... | auto cpu|gpu"
action=$1 fan=$2
case $fan in
cpu) n=1 ;;
gpu) n=2 ;;
*) die 2 "invalid fan '$fan' (cpu or gpu)" ;;
esac

declare -a temps=() pwms=()
case $action in
set)
  (($# == 3)) || die 2 "usage: kelvin-fan-helper set cpu|gpu T1:P1,...,T8:P8"
  IFS=, read -r -a points <<<"$3"
  ((${#points[@]} == 8)) || die 2 "a curve needs exactly 8 points"
  prev_t=-1 prev_p=-1
  for point in "${points[@]}"; do
    [[ $point =~ ^([0-9]{1,3}):([0-9]{1,3})$ ]] || die 2 "invalid point '$point' (expected TEMP:PWM)"
    t=$((10#${BASH_REMATCH[1]})) p=$((10#${BASH_REMATCH[2]}))
    ((t >= 20 && t <= 100)) || die 2 "temperature $t °C out of range (20-100)"
    ((p <= 255)) || die 2 "PWM $p out of range (0-255)"
    ((t > prev_t)) || die 2 "temperatures must strictly increase"
    ((p >= prev_p)) || die 2 "fan speed must not decrease as temperature rises"
    ((t < 70 || p >= 64)) || die 7 "unsafe: at $t °C the fan must run at least 25 % (64)"
    ((t < 80 || p >= 128)) || die 7 "unsafe: at $t °C the fan must run at least 50 % (128)"
    temps+=("$t") pwms+=("$p")
    prev_t=$t prev_p=$p
  done
  ((temps[7] <= 95)) || die 7 "unsafe: the last point must be at or below 95 °C"
  ((pwms[7] >= 128)) || die 7 "unsafe: the last point must be at least 50 % (128)"
  ;;
auto)
  (($# == 2)) || die 2 "usage: kelvin-fan-helper auto cpu|gpu"
  ;;
*) die 2 "invalid action '$action'" ;;
esac

((EUID == 0)) || die 1 "must be run as root through pkexec"

curve=
for hwmon in /sys/class/hwmon/hwmon*; do
  [[ -r $hwmon/name && $(<"$hwmon/name") == asus_custom_fan_curve ]] && curve=$hwmon && break
done
[[ -n $curve && -w $curve/pwm${n}_enable ]] || die 4 "this system has no ASUS custom fan curve for the $fan fan"

if [[ $action == auto ]]; then
  # 3 = restore the factory curve data and hand control back to the firmware.
  printf 3 >"$curve/pwm${n}_enable" 2>/dev/null || printf 2 >"$curve/pwm${n}_enable" || die 5 "the kernel rejected the reset"
  echo "auto $fan enable=$(<"$curve/pwm${n}_enable")"
  exit 0
fi

for i in 0 1 2 3 4 5 6 7; do
  printf '%s' "${temps[$i]}" >"$curve/pwm${n}_auto_point$((i + 1))_temp" || { printf 2 >"$curve/pwm${n}_enable"; die 5 "the kernel rejected point $((i + 1)) temperature"; }
  printf '%s' "${pwms[$i]}" >"$curve/pwm${n}_auto_point$((i + 1))_pwm" || { printf 2 >"$curve/pwm${n}_enable"; die 5 "the kernel rejected point $((i + 1)) speed"; }
done
if ! printf 1 >"$curve/pwm${n}_enable" 2>/dev/null; then
  printf 2 >"$curve/pwm${n}_enable" || true
  die 5 "the kernel rejected the curve; the firmware curve was restored"
fi
[[ $(<"$curve/pwm${n}_enable") == 1 ]] || die 5 "the custom curve did not stay enabled"
echo "set $fan enable=1"
