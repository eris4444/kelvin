#!/bin/bash
# Kelvin privileged helper: ASUS GPU MUX switch.
#
# Runs as root through pkexec (polkit action dev.erisrtg.kelvin.mux, which
# requires administrator authentication). It writes the ASUS firmware
# "gpu_mux_mode" setting exposed by the kernel's asus-armoury driver (or the
# older asus-nb-wmi attribute):
#
#   hybrid    1  Optimus: the Intel iGPU drives the internal panel and the
#                NVIDIA GPU can power down when idle
#   discrete  0  the NVIDIA GPU drives the internal panel directly
#
# The firmware applies the new mode on the next boot. This helper never
# reboots and never touches drivers, modules or the running session.
#
# check-hybrid / check-discrete validate the switch without writing anything
# and work without root.
#
# Usage: kelvin-mux-helper hybrid|discrete|check-hybrid|check-discrete

set -euo pipefail
export PATH=/usr/bin:/bin

readonly ARMOURY=/sys/class/firmware-attributes/asus-armoury/attributes
readonly LEGACY=/sys/devices/platform/asus-nb-wmi

die() {
  local code=$1
  shift
  echo "kelvin-mux-helper: $*" >&2
  exit "$code"
}

(($# == 1)) || die 2 "usage: kelvin-mux-helper hybrid|discrete|check-hybrid|check-discrete"

check_only=false
case $1 in
hybrid) value=1 ;;
discrete) value=0 ;;
check-hybrid) value=1 check_only=true ;;
check-discrete) value=0 check_only=true ;;
*) die 2 "invalid argument '$1'" ;;
esac

if [[ -e $ARMOURY/gpu_mux_mode/current_value ]]; then
  attr=$ARMOURY/gpu_mux_mode/current_value
  possible=$(<"$ARMOURY/gpu_mux_mode/possible_values")
  dgpu_disable=$ARMOURY/dgpu_disable/current_value
  pending=$ARMOURY/pending_reboot
elif [[ -e $LEGACY/gpu_mux_mode ]]; then
  attr=$LEGACY/gpu_mux_mode
  possible="0;1"
  dgpu_disable=$LEGACY/dgpu_disable
  pending=
else
  die 3 "this system has no ASUS GPU MUX control"
fi

[[ ";$possible;" == *";$value;"* ]] || die 4 "the firmware does not accept MUX value $value (possible: $possible)"

if [[ $value == 0 && -r $dgpu_disable && $(<"$dgpu_disable") == 1 ]]; then
  die 4 "the NVIDIA GPU is disabled in firmware (dgpu_disable=1); Discrete mode needs it enabled"
fi

current=$(<"$attr")
if [[ $current == "$value" ]]; then
  echo "unchanged mux=$value"
  exit 0
fi

if $check_only; then
  echo "ok mux=$current->$value"
  exit 0
fi

((EUID == 0)) || die 1 "must be run as root through pkexec"

printf '%s' "$value" >"$attr" 2>/dev/null || die 5 "the firmware rejected the MUX change"
[[ $(<"$attr") == "$value" ]] || die 5 "the firmware did not keep the new MUX value"

pending_value=unknown
[[ -n $pending && -r $pending ]] && pending_value=$(<"$pending")
echo "changed mux=$value pending_reboot=$pending_value"
